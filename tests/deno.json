            "dom",
            "esnext"
        ]
    },
    "imports": {
        "@velotype/veloserver": "jsr:@velotype/veloserver@^0.0.2",
        "@velotype/velomicro/jsx-runtime": "../src/jsx-runtime/jsx-runtime.ts",
        "@velotype/velomicro": "../src/jsx-runtime/jsx-runtime.ts"
    },
    "lint": {
        "rules": {
            "exclude": [
                "jsx-key"
            ]
        }
    }
}
